# Copy to .env (or edit everything from Settings in the control panel).

# Control panel
ALPHA_PORT=7300
# Optional: keep Accounts, Profiles, Logs, ... in another folder instead of the app folder.
ALPHA_HOME=
# Passphrase that encrypts saved account passwords. Use the same value on every computer.
ALPHA_SECRET=

# Supabase (leave empty to run in local mode on one computer)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google OAuth client (Supabase Google provider, and optionally rclone's own Drive client)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Drive sync (rclone)
RCLONE_REMOTE=gdrive
RCLONE_ROOT=Alpha-Sales
RCLONE_AUTO_SYNC=true

# Optional overrides
CHROME_PATH=
VULPINE_PATH=
AHK_PATH=
PYTHON_PATH=

# AI providers (CLI tools log in from the Accounts page instead)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
OPENCODE_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
JEV_API_KEY=
JEV_BASE_URL=
